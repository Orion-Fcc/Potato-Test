# Optional native binaries must not be skipped: rollup/esbuild ship their platform
# binaries as optional deps, and npm's well-known bug (npm/cli#4828) drops them when
# a previous install was interrupted -> "Cannot find module @rollup/rollup-win32-x64-msvc".
strict-optional=false
# Let esbuild/rollup run their postinstall; without it the native binary is never linked.
ignore-scripts=false
