__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
*.db
*.db-journal
# auto-generated Fernet key (see app/crypto.py) — never commit, it decrypts stored creds
.potato-secret.key*
.potato-rotation.lock
profiles/
artifacts/
auth.json
.pytest_cache/
.ruff_cache/
*.egg-info/
.DS_Store

# Editor / manual backups and bundler temp files. A dated .bak-<name> or a
# vite.config.ts.timestamp-*.mjs is never source — they only bloat a clone.
# The old copies already committed are recoverable from git history if ever needed.
*.bak
*.bak-*
*.bak.*
.bak-*/
*.orig
*~
*.timestamp-*.mjs

web/node_modules/

# 清库前的本地快照（2026-10-17）。可能含原件/截图，**绝不进仓库**。
backups/
# 桌面版打包产物（PyInstaller）：从源码生成，不进仓库。
build/
dist_desktop/
web/tsconfig.tsbuildinfo

# web/dist 是构建产物，不提交（2026-10-21 用户要求）。
# 部署/打包时由 scripts/deploy.* 或 `cd web && npm run build` 重新生成。
web/dist/

# background server runtime state: PID file + uvicorn logs
.potato.pid
logs/
# Feishu poll worker PID (app/feishu_poll.py writes it; the desktop .bat reads it)
.feishu_ws.pid

*.png
# but keep app icons served by the web app
!web/public/*.png
!docs/screenshots/*.png

# 临时文件（提交信息、一次性脚本等）
.git_msg.tmp
_*.tmp

# 一次性脚本与临时文件（仓库根目录下以 _ 开头的任何东西）。
# 它们要么用完即删，要么**按设计就写着要抹掉的真实标识** —— 后者绝对不能入库，
# 否则一次 `git add -A` 就把刚脱敏的东西又塞回去。
#
# 写成 `/_*`（只锚定根目录）：去掉前导斜杠的 `_` 会连带匹配 app/__init__.py 这类包文件。
/_*

# ★ 本机真实标识清单（scripts/check_secrets.py 与 redact_history.py 都读它）。
# 清单的内容恰恰是不能公开的东西（网关地址、客户名、内网地址……），所以**绝不能入库**。
# 模板见 scripts/secrets.local.example.json。
.secrets.local.json

# 后悔药：重写历史前的完整备份（git bundle）。
# 它保存的是**重写之前**的历史 —— 也就是"已经从远端抹掉、但仍可恢复"的那一份，
# 所以性质和 .env 一样敏感，只是用途不同。放在项目里而不是项目外，因为它是
# 这个仓库的一部分；靠这一行保证它永远不会被 git add -A 带进去。
/.backups/

# 归档的过时备份（.env / potato.db / BAT 快照）——留作后悔药，不入库
scripts/desktop/_superseded/

# 覆盖率产物（2026-10-08 引入 pytest-cov 后开始生成）。
# 它是每次跑测试重新生成的中间物，入库只会造成无意义的 diff 噪音。
.coverage
.coverage.*
htmlcov/
coverage.xml

# 在工作区里跑测试时用的临时目录（2026-10-09 起显式忽略）。
#
# 为什么会有这个目录：某些受限环境（例如 DSH 沙箱）会把系统 %TEMP% 指到一个
# 新建子目录立刻不可读的位置，于是 pytest 的 tmp_path 全部报 PermissionError ——
# 那种红与产品代码无关，却会淹掉真正的失败。绕法是把临时目录指到工作区内，见
# CONTRIBUTING.md「提交前自检」。里面装的是临时库、覆盖率 JSON、一次性诊断脚本。
# 注意 `/_*`（见下）匹配的是**下划线**开头，`.tmp` 是点开头，两者不重叠。
.tmp/

# token 测量产物（`_measure_tokens.py --tag <name>` 写出来的）。
# 每跑一次就覆盖，属于本机实测数据，入库只会是噪音。
.tok_*.json

# 本项目在 WorkBuddy 里工作时留下的数据目录（项目备份、临时文件）。
# 里面有导出的用例 JSON，含被测系统的内网地址，而本仓库是**公开**的 —— 不入库。
.workbuddy/

# 从界面导出的项目配置快照（可能带地址、环境、账号名）。
project_settings_backup.json

# 一次性重定向事故留下的垃圾文件（BAT 的 `> 2>&1` 被误敲成 `> 3.5)`）。
# 忽略而不是删除：删文件是不可逆操作，留在这里至少不会再污染 git status。
3.5)

# 数据库迁移前快照（app/db.py 用 VACUUM INTO 生成，启动时自动写）。
# 里面是整库副本，可能含加密凭据与账号信息，只应留在本机 —— 不入库。
.potato-backups/
